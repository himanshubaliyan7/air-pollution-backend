    "/api/v1/forecast/{station_id}": {
      "get": {
        "tags": [
          "forecasts"
        ],
        "summary": "Get Forecast",
        "operationId": "get_forecast_api_v1_forecast__station_id__get",
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Station Id"
