    "/api/v1/stations": {
      "get": {
        "tags": [
          "stations"
        ],
        "summary": "List Stations",
        "description": "Stations with a current forecast come first: the upstream sensor feed\nlags for most of the network, so most stations cannot be forecast right now\nand clients need to tell them apart.",
