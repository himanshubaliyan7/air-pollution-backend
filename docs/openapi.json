                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions/manage": {
      "post": {
        "tags": [
          "subscriptions"
        ],
        "summary": "Manage Subscription",
        "description": "Replace the stations/pollutants of a confirmed subscription (and switch\nit on, which is how someone who unsubscribed re-subscribes). Authorised\nonly by the emailed manage token.",
        "operationId": "manage_subscription_api_v1_subscriptions_manage_post",
        "requestBody": {
          "content": {
            "application/json": {
