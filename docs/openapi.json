    "/api/v1/stations": {
      "get": {
        "tags": [
          "stations"
        ],
        "summary": "List Stations",
        "description": "Stations with a current forecast come first: the upstream sensor feed\nlags for most of the network, so most stations cannot be forecast right now\nand clients need to tell them apart.",
        "operationId": "list_stations_api_v1_stations_get",
        "parameters": [
          {
            "name": "region_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StationOut"
                  },
                  "title": "Response List Stations Api V1 Stations Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
