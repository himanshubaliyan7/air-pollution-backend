    "/api/v1/subscriptions": {
      "post": {
        "tags": [
          "subscriptions"
        ],
        "summary": "Create Subscription",
        "description": "Creates a subscription for a NEW email only.\n\nDeliberately never modifies, reactivates or reveals an existing row: with\nno proof of email ownership, an upsert would let anyone overwrite a\nvictim's stations and read back their subscriber_id (the only credential\nfor DELETE). A 409 is returned instead. Changing or re-enabling a\nsubscription needs an owner-verified flow (emailed confirmation token),\nwhich is not built yet.",
        "operationId": "create_subscription_api_v1_subscriptions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
