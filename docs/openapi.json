    "/api/v1/subscriptions": {
      "post": {
        "tags": [
          "subscriptions"
        ],
        "summary": "Request Subscription",
        "description": "Ask to subscribe. Always answers the same 202 body (no subscriber id, no\nhint whether the address is already known). Emails a confirmation link for\na new/pending address, or a manage link for a confirmed one; nothing is\nactivated or modified until the mailbox owner uses a link.",
        "operationId": "request_subscription_api_v1_subscriptions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionRequestOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions/confirm": {
      "post": {
        "tags": [
          "subscriptions"
        ],
        "summary": "Confirm Subscription",
        "description": "Single-use: the token is erased from the row the moment it works.",
        "operationId": "confirm_subscription_api_v1_subscriptions_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenIn"
