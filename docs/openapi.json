    "/api/v1/subscriptions/delete": {
      "post": {
        "tags": [
          "subscriptions"
        ],
        "summary": "Delete Subscription",
        "description": "Erase the subscription and its send history (\"delete my data\"). Same\ntokens as unsubscribing. Irreversible; subscribing again starts over.",
        "operationId": "delete_subscription_api_v1_subscriptions_delete_post",
        "requestBody": {
