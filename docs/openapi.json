  "components": {
    "schemas": {
      "AqiCategoryOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "AqiCategoryOut"
      },
      "AttributionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "applies_to": {
            "type": "string",
            "title": "Applies To"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "url",
          "required",
          "applies_to"
        ],
        "title": "AttributionOut"
      },
      "CurrentAqiOut": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "is_current": {
            "type": "boolean",
            "title": "Is Current"
          },
          "aqi_standard": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aqi Standard"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          },
          "overall": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OverallAqiOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "at_or_above_health_threshold": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "At Or Above Health Threshold"
          },
          "pollutants": {
            "items": {
              "$ref": "#/components/schemas/PollutantAqiOut"
            },
            "type": "array",
            "title": "Pollutants"
          },
          "attribution": {
            "type": "string",
            "title": "Attribution"
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "as_of",
          "is_current",
          "aqi_standard",
          "timezone",
          "overall",
          "pollutants",
          "attribution"
        ],
        "title": "CurrentAqiOut"
      },
      "ExceedanceDayOut": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "exceedance_flag": {
            "type": "boolean",
            "title": "Exceedance Flag"
          },
          "exceedance_probability": {
            "type": "number",
            "title": "Exceedance Probability"
          },
          "worst_case_value": {
            "type": "number",
            "title": "Worst Case Value"
          },
          "aqi_category": {
            "type": "string",
            "title": "Aqi Category"
          }
        },
        "type": "object",
        "required": [
          "date",
          "exceedance_flag",
          "exceedance_probability",
          "worst_case_value",
          "aqi_category"
        ],
        "title": "ExceedanceDayOut"
      },
      "ExceedanceSummaryOut": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "pollutant": {
            "type": "string",
            "title": "Pollutant"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          },
          "forecast_made_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forecast Made At"
          },
          "is_current": {
            "type": "boolean",
            "title": "Is Current",
            "default": false
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/ExceedanceDayOut"
            },
            "type": "array",
            "title": "Days"
          },
          "overall_recommendation": {
            "type": "string",
            "title": "Overall Recommendation"
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "pollutant",
          "days",
          "overall_recommendation"
        ],
        "title": "ExceedanceSummaryOut"
      },
