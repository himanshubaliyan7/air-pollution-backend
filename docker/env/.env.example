# Copy this file to docker/.env and fill in real values. Never commit the
# real .env - it is gitignored.

# --- Postgres (shared by the app DB and, in a separate database, Airflow's metadata DB) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_SECRET
POSTGRES_DB=airpollution
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:REPLACE_WITH_A_STRONG_SECRET@postgres:5432/airpollution

# Airflow's own metadata DB - same Postgres instance, separate database name.
AIRFLOW_DATABASE_URL=postgresql+psycopg2://postgres:REPLACE_WITH_A_STRONG_SECRET@postgres:5432/airflow

# --- OpenAQ (sensor data - PM2.5 / NO2 for Delhi NCR CPCB stations) ---
# Register at https://explore.openaq.org/register to obtain a key.
OPENAQ_API_KEY=

# --- data.gov.in (CPCB real-time AQI; current conditions per station) ---
# Free: log in at https://data.gov.in, then My Account -> API key. Leave empty to skip.
DATA_GOV_IN_API_KEY=

# --- Copernicus CDS / ERA5 (weather - wind, humidity) ---
# Register at https://cds.climate.copernicus.eu and create an API key.
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# --- SMTP (subscription confirmation emails and the daily digest) ---
# In dev, point these at a local catcher such as MailHog.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_ADDRESS=alerts@air-pollution-prediction.local

# --- Subscriptions (Phase 4) ---
# Frontend base URL that hosts /subscriptions/confirm, /manage, /unsubscribe and
# /subscribe (links in emails). Empty falls back to DASHBOARD_URL.
FRONTEND_BASE_URL=
# Public https URL of this API: the RFC 8058 one-click unsubscribe target that
# mail providers POST to directly.
PUBLIC_API_BASE_URL=http://localhost:8000
# REQUIRED to send the digest or accept unsubscribe links. Generate once:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it breaks every unsubscribe link already emailed.
SUBSCRIPTION_TOKEN_SECRET=
# Demo mode: comma-separated addresses that may subscribe and get the digest.
# Empty = anyone may subscribe. Others get the same reply but nothing is stored or sent.
SUBSCRIPTION_ALLOWED_EMAILS=

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=REPLACE_WITH_A_STRONG_SECRET
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_SECRET
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- API / dashboard wiring ---
API_BASE_URL=http://api:8000

# --- Non-secret config overrides (paths are defaults, only change if you
# reorganize the config/ directory) ---
AQI_THRESHOLD_CONFIG_PATH=/app/config/thresholds_cpcb.yaml
STATIONS_CONFIG_PATH=/app/config/stations_delhi_ncr.yaml
SETTINGS_CONFIG_PATH=/app/config/settings.yaml

# Public URL of the frontend, linked from alert emails (recipients cannot open the localhost default).
DASHBOARD_URL=http://localhost:8501
# Origins allowed to call the API from a browser (comma-separated). "*" is only for development.
CORS_ALLOWED_ORIGINS=*

# --- Production only (docker-compose.prod.yml) ---
# Hostname Caddy requests a Let's Encrypt cert for and reverse-proxies to the
# API. With no domain, an ip-with-dashes.sslip.io host resolves to that IP
# with zero DNS setup and Let's Encrypt accepts it like any other hostname.
CADDY_SITE_ADDRESS=

# --- Operator alerts (optional; silent until set) ---
# Telegram: create a bot with @BotFather (token), message it once, then read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dead-man's switch: a healthchecks.io check's ping URL (alerts you when hourly pings stop).
HEALTHCHECKS_PING_URL=
